# All variables are optional. Copy to .env.local for local development,
# or add them in your hosting provider's dashboard.

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# the sitemap, robots.txt and Open Graph tags. On Vercel this falls back to the
# production deployment URL automatically if left empty.
NEXT_PUBLIC_SITE_URL=

# Email address shown on the Contact, Privacy and Terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Search Console HTML-tag verification token (the "content" value only).
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). When set, a consent
# banner appears and GA4 only loads after the visitor accepts analytics.
NEXT_PUBLIC_GA_ID=


# --- Future extensions (not used by the current site) ---------------------
# Selects an AI provider adapter registered in src/lib/ai/index.ts.
# Leave empty (or "disabled") to keep every feature 100% local.
# Provider secrets are server-only: never prefix them with NEXT_PUBLIC_.
AI_PROVIDER=
